# Fonts: immutable, 1 year
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Static binary assets: 30 days
/assets/logos/*
  Cache-Control: public, max-age=2592000

/assets/emoji/*
  Cache-Control: public, max-age=2592000

/assets/og/*
  Cache-Control: public, max-age=2592000

/assets/brand/*
  Cache-Control: public, max-age=2592000

# CSS & JS: 1 day (no cache busting, so no immutable)
/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

/components/*
  Cache-Control: public, max-age=86400
