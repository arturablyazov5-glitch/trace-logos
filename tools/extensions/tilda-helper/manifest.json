{
  "manifest_version": 3,
  "name": "Tilda Helper | Trace Logo's",
  "version": "1.1.0",
  "description": "Помощник для редактора Tilda: бейдж блока, Z-index и атрибуты, мультипревью, копирование кода T123, дизайн-токены.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": [
        "*://tilda.ru/page/*",
        "*://*.tilda.ru/page/*",
        "*://tilda.cc/page/*",
        "*://*.tilda.cc/page/*",
        "*://tilda.ru/projects/*",
        "*://*.tilda.ru/projects/*",
        "*://tilda.cc/projects/*",
        "*://*.tilda.cc/projects/*",
        "*://*.tilda.ws/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://tilda.ru/zero/*",
        "*://*.tilda.ru/zero/*",
        "*://tilda.cc/zero/*",
        "*://*.tilda.cc/zero/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
