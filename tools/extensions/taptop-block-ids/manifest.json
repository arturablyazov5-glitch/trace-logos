{
  "manifest_version": 3,
  "name": "Taptop Block IDs",
  "version": "1.0",
  "description": "Переключатель: показывает ID каждой секции Taptop на странице, клик по плашке копирует ID",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Показать ID блоков Taptop",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
